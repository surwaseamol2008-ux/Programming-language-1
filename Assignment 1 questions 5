
#include <iostream>
#include <string>
using namespace std;

class Teacher {
public:
    string name;

    Teacher(string n) {
        name = n;
    }

    void display() {
        cout << "Teacher Name: " << name << endl;
    }
};

class Student {
public:
    string name;

    Student(string n) {
        name = n;
    }

    void display(Teacher &t) {
        cout << "Student Name: " << name << endl;
        cout << "Teacher Name: " << t.name << endl;
    }
};

int main() {
    Teacher t1("Rahul");
    Student s1("Amol");

    s1.display(t1);

    return 0;
}
